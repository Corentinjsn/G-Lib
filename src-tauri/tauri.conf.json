{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "G-Lib",
  "version": "0.14.0",
  "identifier": "com.janso.gamlib",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "G-Lib",
        "decorations": false,
        "visible": false,
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#0b0d12"
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "G-Lib",
        "decorations": false,
        "resizable": false,
        "center": true,
        "width": 340,
        "height": 400,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://*.steamstatic.com https://images.igdb.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3NjRBQTJFQUE4NkFDMzkKUldRNXJJYXFMcXBrUnc0eThyU0pDRXNzUHBiQkhyNFZETlVQM0tybkd6dlpWcFpEZjhEenF0WVUK",
      "endpoints": [
        "https://github.com/Corentinjsn/GAMLIB/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
