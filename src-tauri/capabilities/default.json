{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:allow-restart",
    "allow-load-cached-library",
    "allow-scan-library",
    "allow-fetch-catalog",
    "allow-launch-game",
    "allow-open-install-dir",
    "allow-uninstall-game",
    "allow-refresh-playtime",
    "allow-list-flags",
    "allow-set-game-flag",
    "allow-list-collections",
    "allow-create-collection",
    "allow-rename-collection",
    "allow-delete-collection",
    "allow-set-collection-membership",
    "allow-finish-splash",
    "allow-search-market",
    "allow-market-home",
    "allow-store-offers",
    "allow-open-store-url",
    "allow-open-redeem",
    "allow-open-friends"
  ]
}
